# Frontal HTTPS para la LAN de la institucion.  --  PLANTILLA
#
# setup-lan.sh rellena @DOMAIN@ y @DNS_DIRECTIVE@ y escribe el resultado en
# /etc/caddy/Caddyfile. Se puede editar despues a mano; el script no sobrescribe
# un Caddyfile que ya mencione el dominio.
#
# Por que Caddy y no exponer uvicorn con TLS directamente: renueva el
# certificado solo y recarga sin cortar el servicio. Con un cert manual hay que
# acordarse cada 60 dias, y el dia que caduque nadie puede grabar.

{
	# Avisos de expiracion de Let's Encrypt. Cambialo por un correo real.
	email @EMAIL@

	# Para validar la configuracion sin gastar cuota de Let's Encrypt
	# (5 fallos por hora y por dominio), descomentar el entorno de pruebas. El
	# navegador desconfiara del certificado: sirve para probar, no para producir.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

@DOMAIN@ {

	# --- Certificado por DNS-01 --------------------------------------------
	# DNS-01 es el unico desafio que NO necesita que Let's Encrypt alcance el
	# servidor: se valida poniendo un registro TXT en la zona. Por eso funciona
	# para un servicio que solo vive en la red interna, con el puerto 80 cerrado.
	#
	# El plugin del proveedor lo instala setup-lan.sh con `caddy add-package`.
	# El token va en /etc/caddy/caddy.env (chmod 600), nunca aca.
	tls {
		@DNS_DIRECTIVE@
		# Resolvers publicos: si el DNS interno no ve los TXT de la zona
		# publica, la validacion falla sin explicacion clara.
		resolvers 1.1.1.1 8.8.8.8
	}

	# --- Proxy a la app ----------------------------------------------------
	reverse_proxy 127.0.0.1:8000 {

		# CRITICO: borrar las cabeceras de identidad que solo Tailscale Serve
		# tiene derecho a poner. Sin esto, un cliente de la LAN podria enviar
		# `Tailscale-User-Login: director@institucion.cr` y aparecer como esa
		# persona en las actas.
		header_up -Tailscale-User-Login
		header_up -Tailscale-User-Name
		header_up -Tailscale-User-Profile-Pic

		# La app lee el ULTIMO valor de X-Forwarded-For, que es el que agrega
		# Caddy: asi el bloqueo por intentos fallidos no se evade mandando una
		# cadena falsa.
		header_up X-Forwarded-For {remote_host}

		# El audio va por WebSocket y una reunion dura horas: sin esto el proxy
		# corta la sesion a mitad de la reunion.
		transport http {
			read_timeout 6h
			write_timeout 6h
		}
	}

	# El audio no sube por HTTP (va por WebSocket), asi que los POST son
	# minimos. Un tope bajo reduce la superficie.
	request_body {
		max_size 1MB
	}

	header {
		# Un ano de HSTS: el navegador se niega a hablar en claro con este host.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# La pagina es autocontenida: no carga nada de terceros.
		Content-Security-Policy "default-src 'self'; media-src 'self' blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss: ws:"
		-Server
	}

	log {
		output file /var/log/caddy/listener.log {
			roll_size 20MB
			roll_keep 5
		}
		# Las URLs traen ids de reunion, no contenido. Aun asi este log revela
		# quien accede a que: tratalo como dato interno.
		format console
	}
}

# ---------------------------------------------------------------------------
# ALTERNATIVA sin plugin de DNS
# ---------------------------------------------------------------------------
# Si el puerto 80 del servidor fuera alcanzable desde internet (aunque solo
# durante la emision y las renovaciones), Caddy resuelve el desafio HTTP-01 sin
# ningun plugin ni token: basta con borrar el bloque `tls { ... }`.
#
# Sin dominio propio ni forma de exponer el 80, la salida es una CA interna con
# `caddy trust`, pero hay que instalar el certificado raiz en cada dispositivo:
# friccion parecida a instalar Tailscale.
