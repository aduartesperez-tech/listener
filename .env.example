# ---------------------------------------------------------------------------
# LISTENER - configuracion
# Copiar a .env y ajustar. Todos los valores tienen default razonable.
# ---------------------------------------------------------------------------

# --- Red -------------------------------------------------------------------
# Escuchar solo en loopback: Tailscale Serve hace de frontal TLS.
# NO poner 0.0.0.0 salvo que sepas exactamente por que.
HOST=127.0.0.1
PORT=8000

# --- Idioma ----------------------------------------------------------------
LANGUAGE=es

# Vocabulario institucional: nombres, siglas, terminos que Whisper suele
# escribir mal. Se pasa como initial_prompt y mejora bastante los nombres
# propios. Frase corta, con puntuacion, en el idioma de la reunion.
VOCAB_PROMPT=Reunion institucional. Participan Adrian y el equipo. Se mencionan siglas y nombres propios.

# --- Modelo en vivo --------------------------------------------------------
# small es el piso usable en espanol. base solo si el benchmark no da.
LIVE_MODEL=small
LIVE_COMPUTE=int8
LIVE_THREADS=4
LIVE_BEAM=1

# --- Modelo del acta final (se corre despues de la reunion) ----------------
ENABLE_FINAL=true
# Alternativas si turbo pesa mucho o falla la descarga: medium / small
FINAL_MODEL=large-v3-turbo
FINAL_COMPUTE=int8
FINAL_THREADS=4
FINAL_BEAM=5

# --- Diarizacion (etiquetar quien habla) -----------------------------------
# Requiere: pip install pyannote.audio  + token de HuggingFace con las
# licencias de pyannote/speaker-diarization-3.1 aceptadas.
# Probar primero SIN esto: arrastra PyTorch y es lenta en un i5-6500T.
ENABLE_DIARIZATION=false
HF_TOKEN=

# --- Segmentacion por VAD --------------------------------------------------
# aggressiveness: 0 (permisivo) a 3 (estricto). 2 va bien en sala.
VAD_AGGRESSIVENESS=2
# ms de voz continua para abrir una frase
VAD_START_MS=90
# ms de silencio para cerrarla -> es lo que define la latencia percibida
VAD_END_MS=700
# audio previo que se conserva para no cortar el arranque de la palabra
VAD_PREROLL_MS=300
# corte forzado: Whisper trabaja en ventanas de 30 s, no conviene acercarse
MAX_UTTERANCE_SEC=20
# frases mas cortas que esto se descartan como ruido
MIN_UTTERANCE_SEC=0.35

# --- Acceso ----------------------------------------------------------------
# Contrasena compartida. VACIO = sin autenticacion: cualquiera que alcance el
# puerto entra y puede leer TODAS las actas. Solo aceptable si el unico camino
# de entrada es Tailscale.
#
# Obligatoria si la app se publica en la LAN de la institucion.
# Este archivo debe quedar en chmod 600 (install.sh ya lo hace).
AUTH_PASSWORD=

# Firma de la cookie de sesion. Si se deja vacio se genera y se guarda en
# data/session.key, lo que mantiene las sesiones vivas entre reinicios.
# Cambiarlo cierra la sesion de todo el mundo.
SESSION_SECRET=

# Horas que dura la sesion antes de volver a pedir la contrasena.
SESSION_HOURS=12

# --- Limites ---------------------------------------------------------------
MAX_MEETING_HOURS=4

# --- Almacenamiento --------------------------------------------------------
DATA_DIR=data
# Cache de modelos de HuggingFace (descarga unica)
MODEL_CACHE_DIR=
